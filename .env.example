# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL / TiDB Cloud Serverless)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username.root
DB_PASSWORD=your_tidb_password
DB_NAME=skywings_airlines
DB_SSL=true
# Tune for the database plan and number of application instances.
DB_CONNECTION_LIMIT=20

# JWT Authentication
# Use a unique cryptographically random value with at least 32 characters.
JWT_SECRET=replace_with_a_unique_32_plus_character_random_secret
JWT_EXPIRES_IN=7d

# Optional Frontend URL for CORS
FRONTEND_URL=https://your-app.vercel.app

# n8n Automated Email Webhook Configuration (Production)
N8N_EMAIL_WEBHOOK_URL=https://hassaanahmad2.app.n8n.cloud/webhook/c1c5404e-9aa6-4f33-b58e-8de402b5403c
